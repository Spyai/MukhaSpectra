# Rendered by the nginx image's envsubst step; NGINX_ENVSUBST_FILTER limits it to MUKHA_ variables.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Same limit as the API (MUKHA_MAX_REQUEST_MB, default 200): a multi-site DNG / 16-bit upload
    # must not be refused here when the API would accept it.
    client_max_body_size 200m;
    client_body_timeout 120s;

    # nginx's own 413 page is HTML; the console expects the API's JSON error shape.
    error_page 413 = @too_large;

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The shared API key (MUKHA_API_KEY) is added here, server-side, so the browser never
        # holds it and plain <img> requests for artifacts are authorised too. Empty = no key.
        proxy_set_header X-API-Key "${MUKHA_API_KEY}";
        # Uploads of large captures and a full analysis of many sites take time.
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location @too_large {
        default_type application/json;
        return 413 '{"detail": "The upload is larger than the 200 MB request limit."}';
    }

    location / {
        try_files $uri /index.html;
    }
}
